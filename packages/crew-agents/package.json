{
  "name": "@deepseek-ai/dsh-crew-agents",
  "description": "Crew agent presets: Mail, Chat, Code, Research and Life specialists and a Chief of staff that delegates to them",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/crew-agents"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-agent-instructions": "workspace:*",
    "@deepseek-ai/dsh-crew-agents-ui": "workspace:*",
    "@deepseek-ai/dsh-crew-chain-of-thought": "workspace:*",
    "@deepseek-ai/dsh-crew-connections": "workspace:*",
    "@deepseek-ai/dsh-crew-faces": "workspace:*",
    "@deepseek-ai/dsh-crew-handoff-ui": "workspace:*",
    "@deepseek-ai/dsh-crew-improve": "workspace:*",
    "@deepseek-ai/dsh-crew-kanban": "workspace:*",
    "@deepseek-ai/dsh-crew-kanban-ui": "workspace:*",
    "@deepseek-ai/dsh-crew-roster": "workspace:*",
    "@deepseek-ai/dsh-crew-slack": "workspace:*",
    "@deepseek-ai/dsh-crew-tool-map-ui": "workspace:*",
    "@deepseek-ai/dsh-crew-workflows": "workspace:*",
    "@deepseek-ai/dsh-crew-workflows-ui": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-persona": "workspace:*",
    "@deepseek-ai/dsh-time-context": "workspace:*",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:*",
    "@deepseek-ai/dsh-tool-bash": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-ptc": "workspace:*",
    "@deepseek-ai/dsh-tool-fs": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-jobs": "workspace:*",
    "@deepseek-ai/dsh-tool-pwsh": "workspace:*",
    "@deepseek-ai/dsh-tool-schedule": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent-control": "workspace:*",
    "@deepseek-ai/dsh-tool-skill": "workspace:*",
    "@deepseek-ai/dsh-tool-todo": "workspace:*",
    "@deepseek-ai/dsh-tool-web": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2"
  }
}
